# 1. Data Loading and Preprocessing --------------------------------------------
Clinical <- read.table("TableS5.txt", header = TRUE, sep = "\t", quote = "", 
                       comment.char = "", stringsAsFactors = FALSE)
Clinical$NaturalDeath <- 1 * (Clinical$Last.Followup.Status %in% c("d", "d-o.c."))

# Exclude sample cases without follow-up or in Stage 4
ids <- which(Clinical$T == 0)
if (length(ids) > 0) Clinical <- Clinical[-ids, ]
Clinical <- Clinical[-which(Clinical$Stage == 4), ]
Clinical <- Clinical[which(!is.na(Clinical$T)), ]
Clinical <- Clinical[which(!is.na(Clinical$Death)), ]

bad.hist <- which(Clinical$Histological.Type %in% c("BENIGN", "PHYL"))
if (length(bad.hist) > 0) Clinical <- Clinical[-bad.hist, ]

# Apply minor perturbations to break tied event times
Clinical$TLR[which(Clinical$TLR == 0)] <- 0.1
Clinical$TDR[which(Clinical$TDR == 0)] <- 0.1
Clinical$T[which(Clinical$T == Clinical$TDR & Clinical$DR == 1)] <- Clinical$T[which(Clinical$T == Clinical$TDR & Clinical$DR == 1)] + 0.1
Clinical$T[which(Clinical$T == Clinical$TLR & Clinical$LR == 1)] <- Clinical$T[which(Clinical$T == Clinical$TLR & Clinical$LR == 1)] + 0.1
Clinical$TDR[which(Clinical$TLR == Clinical$TDR & Clinical$LR == 1 & Clinical$DR == 1)] <- Clinical$TDR[which(Clinical$TLR == Clinical$TDR & Clinical$LR == 1 & Clinical$DR == 1)] + 0.1

Clinical$TLR[which(Clinical$LR == 0)] <- Clinical$T[which(Clinical$LR == 0)]
Clinical$TDR[which(Clinical$DR == 0)] <- Clinical$T[which(Clinical$DR == 0)]

Clinical$LR[which(Clinical$TLR > Clinical$TDR)] <- 0
Clinical$TLR[which(Clinical$TLR > Clinical$TDR)] <- Clinical$T[which(Clinical$TLR > Clinical$TDR)]

# Convert follow-up times to years
Clinical$T   <- Clinical$T / 365.25
Clinical$TLR <- Clinical$TLR / 365.25
Clinical$TDR <- Clinical$TDR / 365.25

Clinical$LN    <- Clinical$Lymph.Nodes.Positive
Clinical$LN[which(Clinical$LN >= 10)] <- 10
Clinical$AGE   <- Clinical$Age.At.Diagnosis
Clinical$GRADE <- as.numeric(as.character(Clinical$Grade))
Clinical$SIZE  <- as.numeric(as.character(Clinical$Size))
Clinical$BS    <- factor(Clinical$Breast.Surgery, levels = c("BREAST CONSERVING", "MASTECTOMY"), labels = c("BC", "M"))
Clinical$ER.Status <- factor(Clinical$ER.Status, levels = c("neg", "pos"), labels = c("ER-", "ER+"))

# Transition Matrix Construction (10 states: 5 for ER- and 5 for ER+)
tra <- matrix(NA, 5 * 2, 5 * 2)
state.names <- paste(c("PostSurgery", "LocalRelapse", "DistantRelapse", "CancerDeath", "NaturalDeath"),
                     rep(levels(Clinical$ER.Status), rep(5, 2)), sep = "_")
rownames(tra) <- state.names
colnames(tra) <- rownames(tra)

counter <- 1
for (i in seq(from = 1, by = 5, length = 2)) {
  tra[i, (i + 1):(i + 4)] <- counter:(counter + 3)
  counter <- counter + 4
  tra[i + 1, (i + 2):(i + 4)] <- counter:(counter + 2)
  counter <- counter + 3
  tra[i + 2, (i + 3):(i + 4)] <- counter:(counter + 1)
  counter <- counter + 2
}

ALL.CLINICAL <- Clinical

# Build long-format multi-state data structure (msdata)
set.seed(12324)
all.X <- list()
for (ic in levels(ALL.CLINICAL$ER.Status)) {
  Clinical_sub <- ALL.CLINICAL[which(ALL.CLINICAL$ER.Status == ic), ]
  X <- NULL
  for (i in 1:nrow(Clinical_sub)) {
    # 1. Surgery -> Local
    tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 1, to = 2, trans = 1,
                      Tstart = 0, Tstop = min(Clinical_sub$TLR[i], Clinical_sub$TDR[i]),
                      status = Clinical_sub$LR[i], LN = Clinical_sub$LN[i], AGE = Clinical_sub$AGE[i],
                      GRADE = Clinical_sub$GRADE[i], SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i],
                      ER = Clinical_sub$ER.Status[i], TLastSurgery = 0, TLastLocal = 0)
    X <- rbind(X, tmp)
    
    # 2. Surgery -> Distant
    tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 1, to = 3, trans = 2,
                      Tstart = 0, Tstop = min(Clinical_sub$TLR[i], Clinical_sub$TDR[i]),
                      status = 1 * (Clinical_sub$LR[i] == 0) * Clinical_sub$DR[i], LN = Clinical_sub$LN[i],
                      AGE = Clinical_sub$AGE[i], GRADE = Clinical_sub$GRADE[i], SIZE = Clinical_sub$SIZE[i],
                      BS = Clinical_sub$BS[i], ER = Clinical_sub$ER.Status[i], TLastSurgery = 0, TLastLocal = 0)
    X <- rbind(X, tmp)
    
    # 3. Surgery -> Cancer Death
    tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 1, to = 4, trans = 3,
                      Tstart = 0, Tstop = min(Clinical_sub$TLR[i], Clinical_sub$TDR[i]),
                      status = 1 * (Clinical_sub$LR[i] == 0 & Clinical_sub$DR[i] == 0) * Clinical_sub$DeathBreast[i],
                      LN = Clinical_sub$LN[i], AGE = Clinical_sub$AGE[i], GRADE = Clinical_sub$GRADE[i],
                      SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i], ER = Clinical_sub$ER.Status[i],
                      TLastSurgery = 0, TLastLocal = 0)
    X <- rbind(X, tmp)
    
    # 4. Surgery -> Natural Death
    tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 1, to = 5, trans = 4,
                      Tstart = 0, Tstop = min(Clinical_sub$TLR[i], Clinical_sub$TDR[i]),
                      status = 1 * (Clinical_sub$LR[i] == 0 & Clinical_sub$DR[i] == 0) * Clinical_sub$NaturalDeath[i],
                      LN = Clinical_sub$LN[i], AGE = Clinical_sub$AGE[i], GRADE = Clinical_sub$GRADE[i],
                      SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i], ER = Clinical_sub$ER.Status[i],
                      TLastSurgery = 0, TLastLocal = 0)
    X <- rbind(X, tmp)
    
    # Local Relapses
    if (Clinical_sub$LR[i] == 1) {
      tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 2, to = 3, trans = 5,
                        Tstart = Clinical_sub$TLR[i], Tstop = min(Clinical_sub$TDR[i], Clinical_sub$T[i]),
                        status = Clinical_sub$DR[i], LN = Clinical_sub$LN[i], AGE = Clinical_sub$AGE[i] + Clinical_sub$TLR[i],
                        GRADE = Clinical_sub$GRADE[i], SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i],
                        ER = Clinical_sub$ER.Status[i], TLastSurgery = Clinical_sub$TLR[i], TLastLocal = 0)
      X <- rbind(X, tmp)
      
      tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 2, to = 4, trans = 6,
                        Tstart = Clinical_sub$TLR[i], Tstop = min(Clinical_sub$TDR[i], Clinical_sub$T[i]),
                        status = 1 * (Clinical_sub$DR[i] == 0) * Clinical_sub$DeathBreast[i], LN = Clinical_sub$LN[i],
                        AGE = Clinical_sub$AGE[i] + Clinical_sub$TLR[i], GRADE = Clinical_sub$GRADE[i],
                        SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i], ER = Clinical_sub$ER.Status[i],
                        TLastSurgery = Clinical_sub$TLR[i], TLastLocal = 0)
      X <- rbind(X, tmp)
      
      tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 2, to = 5, trans = 7,
                        Tstart = Clinical_sub$TLR[i], Tstop = min(Clinical_sub$TDR[i], Clinical_sub$T[i]),
                        status = 1 * (Clinical_sub$DR[i] == 0) * Clinical_sub$NaturalDeath[i], LN = Clinical_sub$LN[i],
                        AGE = Clinical_sub$AGE[i] + Clinical_sub$TLR[i], GRADE = Clinical_sub$GRADE[i],
                        SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i], ER = Clinical_sub$ER.Status[i],
                        TLastSurgery = 0, TLastLocal = 0)
      X <- rbind(X, tmp)
    }
    
    # Distant Relapses
    if (Clinical_sub$DR[i] == 1) {
      TLastSurgery <- if (Clinical_sub$LR[i] == 1) Clinical_sub$TDR[i] else Clinical_sub$TDR[i]
      TLastLocal   <- if (Clinical_sub$LR[i] == 1) Clinical_sub$TDR[i] - Clinical_sub$TLR[i] else 0
      
      tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 3, to = 4, trans = 8,
                        Tstart = Clinical_sub$TDR[i], Tstop = Clinical_sub$T[i], status = Clinical_sub$DeathBreast[i],
                        LN = Clinical_sub$LN[i], AGE = Clinical_sub$AGE[i] + Clinical_sub$TDR[i], GRADE = Clinical_sub$GRADE[i],
                        SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i], ER = Clinical_sub$ER.Status[i],
                        TLastSurgery = TLastSurgery, TLastLocal = TLastLocal)
      X <- rbind(X, tmp)
      
      tmp <- data.frame(id = Clinical_sub$METABRIC.ID[i], from = 3, to = 5, trans = 9,
                        Tstart = Clinical_sub$TDR[i], Tstop = Clinical_sub$T[i], status = Clinical_sub$NaturalDeath[i],
                        LN = Clinical_sub$LN[i], AGE = Clinical_sub$AGE[i] + Clinical_sub$TDR[i], GRADE = Clinical_sub$GRADE[i],
                        SIZE = Clinical_sub$SIZE[i], BS = Clinical_sub$BS[i], ER = Clinical_sub$ER.Status[i],
                        TLastSurgery = 0, TLastLocal = 0)
      X <- rbind(X, tmp)
    }
  }
  all.X[[ic]] <- X
}

res <- all.X
for (i in 1:length(res)) {
  res[[i]]$from  <- res[[i]]$from + 5 * (i - 1)
  res[[i]]$to    <- res[[i]]$to + 5 * (i - 1)
  res[[i]]$trans <- res[[i]]$trans + 9 * (i - 1)
}
res <- do.call("rbind", res)
res$time <- res$Tstop - res$Tstart

nat.death <- as.numeric((tra[, grep("NaturalDeath", colnames(tra))]))
nat.death <- unique(na.omit(nat.death))
