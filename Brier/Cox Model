# ==============================================================================
# CLOCK-RESET COX MODEL: MODEL FIT & STANDARDIZED IPCW BRIER SCORE EVALUATION
# ==============================================================================

# 1. Fit Stratified Semi-Parametric Cox Model (Clock-Reset) --------------------
fm_train <- coxph(
  Surv(time, status) ~ strata(trans) + 
    AGE.PS.NEG + AGE.LR.NEG + AGE.DR.NEG + AGE.PS.POS + AGE.LR.POS + AGE.DR.POS + 
    GRADE.PS.NEG + GRADE.LR.NEG + GRADE.DR.NEG + GRADE.PS.POS + GRADE.LR.POS + GRADE.DR.POS + 
    SIZE.PS.NEG + SIZE.LR.NEG + SIZE.DR.NEG + SIZE.PS.POS + SIZE.LR.POS + SIZE.DR.POS + 
    LN.PS.NEG + LN.LR.NEG + LN.DR.NEG + LN.PS.POS + LN.LR.POS + LN.DR.POS + 
    TLastSurgery.LR.NEG + TLastSurgery.DR.NEG + TLastSurgery.LR.POS + TLastSurgery.DR.POS + 
    TLastLocal.DR.NEG + TLastLocal.DR.POS + cluster(id), 
  data = res.train
)

# Extract Baseline Cumulative Hazards Lambda_0,j(t)
base_haz <- basehaz(fm_train, centered = FALSE)
base_haz$trans_num <- as.numeric(gsub("trans=", "", as.character(base_haz$strata)))
num_trans_total <- max(base_haz$trans_num, na.rm = TRUE)

# 2. Predicted Cumulative Distribution Function Extractor: F_j(t | x_i) --------
get_cox_pred_cdf <- function(model, base_haz_df, test_data, time_eval) {
  pred_list <- vector("list", num_trans_total)
  
  for (j in 1:num_trans_total) {
    data_j <- test_data %>% filter(trans == j)
    N_j    <- nrow(data_j)
    
    if (N_j == 0) {
      pred_list[[j]] <- numeric(0)
      next
    }
    
    # Linear predictor
    lp_scores <- tryCatch(
      predict(model, newdata = data_j, type = "lp"),
      error = function(e) rep(0, N_j)
    )
    lp_scores[is.na(lp_scores)] <- 0
    risk_scores <- exp(lp_scores)
    
    # Retrieve Lambda_0,j(time_eval)
    haz_j <- base_haz_df %>% filter(trans_num == j, time <= time_eval)
    
    if (nrow(haz_j) == 0) {
      cum_haz_base <- 0
    } else {
      cum_haz_base <- haz_j$hazard[which.max(haz_j$time)]
    }
    
    # Predicted CDF: P(T <= time_eval) = 1 - exp(- Lambda_0,j(t) * exp(lp_i))
    surv_prob <- exp(- cum_haz_base * risk_scores)
    cdf_prob  <- 1 - surv_prob
    cdf_prob[is.na(cdf_prob)] <- 1
    
    pred_list[[j]] <- cdf_prob
  }
  
  return(pred_list)
}

# 3. IPCW Brier Score Function (Harmonized with BNP Pipeline) -----------------
compute_ipcw_brier_trans_cox <- function(tr_select, time_eval, test_data, pred_cdf_list) {
  
  data_j <- test_data %>% filter(trans == tr_select)
  pred_j <- pred_cdf_list[[tr_select]]
  
  if (nrow(data_j) == 0 || length(pred_j) == 0) return(NA)
  
  times  <- data_j$time
  status <- data_j$status
  
  # Kaplan-Meier Censoring Distribution per Transition
  km_cens <- survfit(Surv(time, status == 0) ~ 1, data = data_j)
  
  get_G <- function(t_val) {
    if (t_val <= 0) return(1)
    g <- summary(km_cens, times = t_val)$surv
    if (length(g) == 0 || is.na(g) || g == 0) return(1e-4)
    return(g)
  }
  
  G_time_eval <- get_G(time_eval)
  
  weights     <- numeric(length(times))
  include_obs <- logical(length(times))
  Y_obs       <- numeric(length(times))
  
  for (i in 1:length(times)) {
    if (times[i] <= time_eval && status[i] == 1) {
      Y_obs[i]       <- 1
      weights[i]     <- 1 / get_G(times[i])
      include_obs[i] <- TRUE
    } else if (times[i] > time_eval) {
      Y_obs[i]       <- 0
      weights[i]     <- 1 / G_time_eval
      include_obs[i] <- TRUE
    } else {
      include_obs[i] <- FALSE
    }
  }
  
  if (sum(include_obs) == 0) return(NA)
  
  squared_errors <- (pred_j[include_obs] - Y_obs[include_obs])^2
  w_included     <- weights[include_obs]
  
  # IPCW weighted Brier Score calculation (Graf et al. 1999 / Gerds & Schumacher 2006)
  return(sum(w_included * squared_errors) / sum(w_included))
}

# 4. Consolidated Evaluation at 5 and 10 Years ---------------------------------
pred_Cox_5yr  <- get_cox_pred_cdf(fm_train, base_haz, res.test, time_eval = 5)
pred_Cox_10yr <- get_cox_pred_cdf(fm_train, base_haz, res.test, time_eval = 10)

brier_cox_5yr <- sapply(1:num_trans_total, function(j) {
  compute_ipcw_brier_trans_cox(j, time_eval = 5, test_data = res.test, pred_cdf_list = pred_Cox_5yr)
})

brier_cox_10yr <- sapply(1:num_trans_total, function(j) {
  compute_ipcw_brier_trans_cox(j, time_eval = 10, test_data = res.test, pred_cdf_list = pred_Cox_10yr)
})

